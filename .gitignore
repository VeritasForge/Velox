# Neovim swap files
*.swp
*.swo

# Undo files (if you configure undodir locally, though usually in ~/.local/state)
*.un~

# Session files
Session.vim

# Logs
*.log

# Mac system files
.DS_Store

# Docs (specs are committed for traceability; everything else under docs/ stays local, e.g. plans/)
docs/*
!docs/superpowers/
docs/superpowers/*
!docs/superpowers/specs/

# Note: Do NOT ignore lazy-lock.json. It ensures plugin version consistency across machines.

